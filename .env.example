# Railway Environment Variables
# Copy this to .env and fill in your values

# MongoDB Connection (Atlas or Railway MongoDB)
MONGO_URI=mongodb://username:password@host:27017/vaultwalletdb?ssl=true&replicaSet=replicaSet

# Telegram Bot (optional - for wallet approval notifications)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Session Secret (generate a random string)
SESSION_SECRET=your-random-secret-key-here

# Frontend URL(s) for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,https://your-frontend.railway.app

# Environment
NODE_ENV=production

# Optional: IP geolocation
IPINFO_TOKEN=your-ipinfo-token
